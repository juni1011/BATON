# Local development only. Replace this value before use.
DB_PASSWORD=replace-with-your-local-db-password

# Google Gemini API 키. 계약서 사진·문장 추출과 지원사업 AI 추천에 쓴다. 비워 두면 AI 기능은 503을 돌려준다.
# Spring Boot는 .env를 읽지 않으므로 서버를 띄우는 터미널에서 source .env로 불러오거나 환경변수로 직접 설정한다.
GEMINI_API_KEY=

# 온통청년 Open API 인증키. 비워 두면 추천할 지원사업이 비어 있다.
YOUTH_API_KEY=
